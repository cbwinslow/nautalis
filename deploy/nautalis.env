# Nautalis Daemon Environment Configuration
# Copy this file to /etc/nautalis/env or adjust systemd service accordingly

# Database connection (required)
DATABASE_URL=postgresql://nautalis:nautalis@localhost:5432/nautalis

# Optional: Override server URL for Claude hooks (default: http://localhost:3001)
# NAUTALIS_SERVER_URL=http://127.0.0.1:3001

# Optional: Log level (info, warn, error, debug)
# OTEL_LOG_LEVEL=info

# Optional: OpenTelemetry exporter endpoint
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Optional: Embedding provider configuration (default: ollama)
# NAUTALIS_EMBED_PROVIDER=ollama
# NAUTALIS_EMBED_OLLAMA_URL=http://localhost:11434

# Optional: LLM provider configuration (default: ollama)
# NAUTALIS_LLM_PROVIDER=ollama
# NAUTALIS_LLM_OLLAMA_URL=http://localhost:11434
# NAUTALIS_LLM_MODEL=qwen2.5:3b
