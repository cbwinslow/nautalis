# Nautalis Configuration
NAUTALIS_USER_ID=
NAUTALIS_TEAM_ID=

# Deployment mode: local (baremetal host), docker (compose network), baremetal (alias for local)
# NAUTALIS_DEPLOYMENT=local

# Database (PostgreSQL — required)
# Option A: Direct connection string
DATABASE_URL=postgresql://nautalis:nautalis@localhost:5432/nautalis
# Option B: Individual components (used if DATABASE_URL not set)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE_NAME=nautalis
# PG_DATABASE_USER=nautalis
# PG_DATABASE_PASSWORD=nautalis
NAUTALIS_DB_DRIVER=postgres

# Or use Supabase
# NAUTALIS_DB_DRIVER=supabase
# NAUTALIS_SUPABASE_URL=https://your-project.supabase.co
# NAUTALIS_SUPABASE_SERVICE_KEY=

 # Embeddings
 NAUTALIS_EMBED_PROVIDER=ollama
 NAUTALIS_EMBED_MODEL=nomic-embed-text
 NAUTALIS_EMBED_OLLAMA_URL=http://localhost:11434
 # NAUTALIS_EMBED_OPENAI_API_KEY=
 # NAUTALIS_EMBED_COHERE_API_KEY=
 # For OpenRouter embeddings (free tier models, e.g., openai/text-embedding-3-small):
 # NAUTALIS_EMBED_PROVIDER=openai
 # NAUTALIS_EMBED_MODEL=openai/text-embedding-3-small
 # NAUTALIS_EMBED_OPENAI_BASE_URL=https://openrouter.ai/api/v1
 # NAUTALIS_EMBED_OPENAI_API_KEY=  (or set OPENROUTER_API_KEY env var)
 # Custom embedding endpoint (for remote model servers, e.g., on Tailscale network):
 # NAUTALIS_EMBED_PROVIDER=custom
 # NAUTALIS_EMBED_CUSTOM_BASE_URL=http://100.x.y.z:11434
 # NAUTALIS_EMBED_CUSTOM_MODEL=nomic-embed-text
 # NAUTALIS_EMBED_CUSTOM_API_KEY_ENV=MY_EMBED_API_KEY

 # LLM (for summarization, decision extraction)
 NAUTALIS_LLM_PROVIDER=ollama
 NAUTALIS_LLM_MODEL=qwen2.5:3b
 NAUTALIS_LLM_OLLAMA_URL=http://localhost:11434
 # NAUTALIS_LLM_OPENAI_API_KEY=
 # NAUTALIS_LLM_ANTHROPIC_API_KEY=
 # Free LLM options via OpenRouter (requires OPENROUTER_API_KEY env var):
 # NAUTALIS_LLM_PROVIDER=openai
 # NAUTALIS_LLM_MODEL=openrouter/free  # auto-selects free model
 # NAUTALIS_LLM_OPENAI_BASE_URL=https://openrouter.ai/api/v1
 # NAUTALIS_LLM_OPENAI_API_KEY=  (or set OPENROUTER_API_KEY)
 #
 # Or specific free models:
 # NAUTALIS_LLM_PROVIDER=openai
 # NAUTALIS_LLM_MODEL=qwen/qwen3-coder:free
 # NAUTALIS_LLM_OPENAI_BASE_URL=https://openrouter.ai/api/v1
 #
 # NAUTALIS_LLM_PROVIDER=openai
 # NAUTALIS_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
 # NAUTALIS_LLM_OPENAI_BASE_URL=https://openrouter.ai/api/v1
 #
 # OpenCode Zen (free):
 # NAUTALIS_LLM_PROVIDER=openai
 # NAUTALIS_LLM_MODEL=gpt-4o-mini
 # NAUTALIS_LLM_OPENAI_BASE_URL=https://api.opencode.dev/zen/v1
 # NAUTALIS_LLM_OPENAI_API_KEY=  (or set OPENCODE_API_KEY)
 #
 # KiloCode Gateway (free):
 # NAUTALIS_LLM_PROVIDER=openai
 # NAUTALIS_LLM_MODEL=claude-3-haiku
 # NAUTALIS_LLM_OPENAI_BASE_URL=https://gateway.kilocode.dev/v1
 # NAUTALIS_LLM_OPENAI_API_KEY=  (or set KILOCODE_API_KEY)
 #
 # OpenClaude (free Anthropic-compatible):
 # NAUTALIS_LLM_PROVIDER=anthropic
 # NAUTALIS_LLM_MODEL=claude-3-haiku
 # NAUTALIS_LLM_ANTHROPIC_BASE_URL=https://api.openclaude.ai/v1
 # NAUTALIS_LLM_ANTHROPIC_API_KEY=  (or set ANTHROPIC_API_KEY)
 #
 # Custom LLM endpoint (OpenAI-compatible):
 # NAUTALIS_LLM_PROVIDER=custom
 # NAUTALIS_LLM_CUSTOM_BASE_URL=http://100.x.y.z:11434
 # NAUTALIS_LLM_CUSTOM_MODEL=llama3:8b
 # NAUTALIS_LLM_CUSTOM_API_KEY_ENV=MY_LLM_API_KEY

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=nautalis
OTEL_RESOURCE_ATTRIBUTES=service.version=0.1.0

# Supabase (for team/enterprise)
# SUPABASE_SERVICE_KEY=
# POSTGRES_PASSWORD=
# GRAFANA_PASSWORD=admin
