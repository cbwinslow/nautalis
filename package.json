{
  "name": "@nautalis/orchestrator",
  "version": "0.1.0",
  "description": "Universal AI Agent Memory & Orchestration Platform",
  "type": "module",
  "bin": {
    "nautalis": "./dist/cli.js"
  },
  "scripts": {
    "dev": "bun run --watch src/cli.ts",
    "build": "bun build src/cli.ts --outdir dist --target bun --minify",
    "start": "bun run dist/cli.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "typecheck": "tsc --noEmit",
    "db:migrate": "DATABASE_URL=${DATABASE_URL:-postgresql://nautalis:nautalis@localhost:5432/nautalis} bun run src/store/migrate.ts",
    "otel:dev": "OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318 bun run src/cli.ts",
    "docker:up": "docker compose -f docker/docker-compose.team.yml up -d",
    "docker:down": "docker compose -f docker/docker-compose.team.yml down"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/instrumentation": "^0.214.0",
    "@opentelemetry/instrumentation-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-logs": "^0.214.0",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.34.0",
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "commander": "^14.0.3",
    "cosmiconfig": "^9.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.0",
    "drizzle-orm": "^0.45.2",
    "fs-extra": "^11.2.0",
    "fuzzy": "^0.1.1",
    "hono": "^4.6.0",
    "ink": "^6.8.0",
    "llamaindex": "^0.12.1",
    "ora": "^9.3.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "react": "^19.2.4",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/uuid": "^10.0.0",
    "@types/fs-extra": "^11.0.4",
    "@types/pg": "^8.11.10",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "bun-types": "^1.1.38"
  },
  "peerDependencies": {
    "react": "^19.2.4"
  }
}
